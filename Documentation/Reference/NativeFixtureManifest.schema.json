{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native App Mutation Fixture Manifest",
  "type": "object",
  "required": ["schemaVersion", "runID", "host", "evidenceDirectory"],
  "anyOf": [{"required": ["notes"]}, {"required": ["reminders"]}],
  "properties": {
    "schemaVersion": {"const": 1},
    "runID": {"type": "string", "format": "uuid"},
    "host": {
      "type": "object",
      "required": ["userID", "osVersion", "osBuild", "architecture"],
      "properties": {
        "userID": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "osVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "osBuild": {"type": "string", "minLength": 1},
        "architecture": {"enum": ["arm64", "x86_64"]}
      }
    },
    "evidenceDirectory": {
      "type": "string",
      "pattern": "^/",
      "description": "Canonical absolute path whose final component equals the lowercase run UUID."
    },
    "notes": {
      "allOf": [
        {"$ref": "#/$defs/scope"},
        {"properties": {
          "accountID": {"pattern": "^x-coredata://"},
          "containerID": {"pattern": "^x-coredata://"}
        }}
      ]
    },
    "reminders": {
      "allOf": [
        {"$ref": "#/$defs/scope"},
        {"properties": {
          "accountID": {"pattern": "^x-apple-reminderkit://"},
          "containerID": {"pattern": "^x-apple-reminderkit://"}
        }}
      ]
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["accountID", "containerID", "appVersion", "appBuild"],
      "properties": {
        "accountID": {"type": "string", "minLength": 1},
        "containerID": {"type": "string", "minLength": 1},
        "appVersion": {"type": "string", "minLength": 1},
        "appBuild": {"type": "string", "minLength": 1}
      }
    }
  }
}
