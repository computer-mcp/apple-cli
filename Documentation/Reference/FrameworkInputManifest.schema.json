{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "apple-cli framework declaration input manifest",
  "type": "object",
  "required": ["schema_version", "inputs"],
  "properties": {
    "schema_version": {"const": 1},
    "inputs": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "dump_root", "macos_version", "os_build", "architecture", "modules"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"},
          "dump_root": {"type": "string", "minLength": 1},
          "source_kind": {"type": "string"},
          "macos_version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"},
          "os_build": {"type": "string", "minLength": 1},
          "architecture": {"enum": ["arm64", "x86_64"]},
          "sdk_version": {"type": "string"},
          "app_version": {"type": "string"},
          "modules": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object", "required": ["presence", "headers"],
                  "properties": {
                    "presence": {"const": "present"},
                    "headers": {
                      "type": "object", "minProperties": 1,
                      "propertyNames": {"pattern": "^[^/\\\\]+\\.h$"},
                      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                    }
                  }
                },
                {
                  "type": "object", "required": ["presence"],
                  "properties": {"presence": {"const": "absent"}},
                  "not": {"required": ["headers"]}
                }
              ]
            }
          }
        }
      }
    }
  }
}
