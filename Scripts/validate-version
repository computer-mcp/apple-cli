#!/usr/bin/env python3
"""Read-only validation of the product version, Changelog and optional existing tag."""

import argparse
import json
from pathlib import Path
import runpy
import subprocess
import sys


SOURCE = Path(__file__).resolve().parents[1]
checker = runpy.run_path(str(SOURCE / "Scripts/verify-release"))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=SOURCE)
    parser.add_argument("--tag", help="Require the matching existing version tag at HEAD")
    parser.add_argument("--json", action="store_true", help="Print source version metadata")
    options = parser.parse_args()
    version = checker["validate_version_inputs"](options.source.resolve(), options.tag)
    if options.json:
        print(json.dumps({
            "version": version, "expected_tag": "v" + version,
            "prerelease": "-" in version, "tag_checked": options.tag is not None,
        }, sort_keys=True))
    else:
        print(version)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"validate-version: {error}", file=sys.stderr)
        sys.exit(1)
