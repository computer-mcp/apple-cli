#!/usr/bin/xcrun swift

import Foundation

struct ModuleConfig {
  let name: String
  let imports: [String]
  let definesSwiftObject: Bool
  let importsModuleNames: [String]
}

struct ParsedModule {
  var classes: [String: String] = [:]
  var protocols: [String: String] = [:]
  var categories: [(base: String, text: String)] = []
  var forwardClasses: Set<String> = []
  var forwardProtocols: Set<String> = []
  var structNames: Set<String> = []
  var externalSupers: Set<String> = []
  var externalCategoryBases: Set<String> = []
  var orderedClasses: [String] = []
}

let foundationClasses: Set<String> = [
  "NSArray", "NSMutableArray", "NSDictionary", "NSMutableDictionary", "NSSet",
  "NSMutableSet", "NSOrderedSet", "NSMutableOrderedSet", "NSString",
  "NSMutableString", "NSData", "NSMutableData", "NSDate", "NSDateComponents",
  "NSDateInterval", "NSURL", "NSUUID", "NSNumber", "NSError", "NSObject",
  "NSValue", "NSCalendar", "NSTimeZone", "NSLocale", "NSUserDefaults",
  "NSAttributedString", "NSMutableAttributedString", "NSCharacterSet",
  "NSISO8601DateFormatter", "NSFileManager", "NSIndexSet", "NSIndexPath",
  "NSOperationQueue", "NSProgress", "NSPredicate", "NSSortDescriptor",
  "NSBundle", "NSFormatter", "NSMeasurement", "NSUnitDuration",
]

let importedExternalClasses: Set<String> = foundationClasses.union([
  "ACAccount", "CKAllowedSharingOptions", "INIntent", "INIntentResponse",
  "INObject", "INObjectResolutionResult",
])
let importedExternalProtocols: Set<String> = [
  "MLFeatureProvider",
]

func stderr(_ message: String) {
  FileHandle.standardError.write(Data((message + "\n").utf8))
}

func usage() -> Never {
  stderr(
    """
    Usage:
      Scripts/reminderkit-normalize-full-dump --dump-root <path> --sources-root <path>

    Expected dump layout:
      <dump-root>/ReminderKit/ReminderKit/*.h
      <dump-root>/ReminderKitInternal/ReminderKitInternal/*.h

    Output:
      <sources-root>/ReminderKit/include/ReminderKit.h
      <sources-root>/ReminderKit/include/module.modulemap
      <sources-root>/ReminderKitInternal/include/ReminderKitInternal.h
      <sources-root>/ReminderKitInternal/include/module.modulemap
    """
  )
  exit(64)
}

func parseArguments() -> (dumpRoot: URL, sourcesRoot: URL) {
  var dumpRoot: String?
  var sourcesRoot: String?
  var index = 1
  let args = CommandLine.arguments
  while index < args.count {
    let arg = args[index]
    switch arg {
    case "--dump-root":
      index += 1
      guard index < args.count else { usage() }
      dumpRoot = args[index]
    case "--sources-root":
      index += 1
      guard index < args.count else { usage() }
      sourcesRoot = args[index]
    case "--help", "-h":
      usage()
    default:
      stderr("Unknown argument: \(arg)")
      usage()
    }
    index += 1
  }
  guard let dumpRoot, let sourcesRoot else { usage() }
  return (
    URL(fileURLWithPath: dumpRoot, isDirectory: true),
    URL(fileURLWithPath: sourcesRoot, isDirectory: true)
  )
}

func firstCapture(_ text: String, pattern: String) -> String? {
  guard let regex = try? NSRegularExpression(pattern: pattern) else { return nil }
  let ns = text as NSString
  let range = NSRange(location: 0, length: ns.length)
  guard let match = regex.firstMatch(in: text, range: range),
    match.numberOfRanges > 1,
    match.range(at: 1).location != NSNotFound
  else {
    return nil
  }
  return ns.substring(with: match.range(at: 1))
}

func replaceRegex(_ text: String, pattern: String, with replacement: String) -> String {
  guard let regex = try? NSRegularExpression(pattern: pattern) else { return text }
  let ns = text as NSString
  return regex.stringByReplacingMatches(
    in: text,
    range: NSRange(location: 0, length: ns.length),
    withTemplate: replacement
  )
}

func isIdentifier(_ value: String) -> Bool {
  firstCapture(value, pattern: #"^([A-Za-z_][A-Za-z0-9_]*)$"#) != nil
}

func matchingBraceEnd(in text: NSString, openBraceLocation: Int) -> Int? {
  var depth = 0
  var index = openBraceLocation
  while index < text.length {
    let scalar = text.character(at: index)
    if scalar == Character("{").utf16.first! {
      depth += 1
    } else if scalar == Character("}").utf16.first! {
      depth -= 1
      if depth == 0 {
        return index + 1
      }
    }
    index += 1
  }
  return nil
}

func replaceCPPStructs(_ input: String) -> String {
  var text = input
  let prefixes = ["struct basic_string", "struct vector", "struct map", "struct pair"]
  for prefix in prefixes {
    while let prefixRange = text.range(of: prefix) {
      let ns = text as NSString
      let start = ns.range(of: prefix).location
      let searchRange = NSRange(location: start, length: ns.length - start)
      let brace = ns.range(of: "{", range: searchRange)
      guard brace.location != NSNotFound,
        let end = matchingBraceEnd(in: ns, openBraceLocation: brace.location)
      else {
        let swiftStart = prefixRange.lowerBound
        text.replaceSubrange(swiftStart..<prefixRange.upperBound, with: "void *")
        continue
      }
      let before = ns.substring(to: start)
      let after = ns.substring(from: end)
      text = before + "void *" + after
    }
  }
  return text
}

func stripInlineStructs(_ input: String, structNames: inout Set<String>) -> String {
  var text = replaceCPPStructs(input)
  guard let regex = try? NSRegularExpression(pattern: #"\bstruct\s+([A-Za-z_][A-Za-z0-9_]*)\s*\{"#) else {
    return text
  }

  while true {
    let ns = text as NSString
    let range = NSRange(location: 0, length: ns.length)
    guard let match = regex.firstMatch(in: text, range: range) else { return text }
    let name = ns.substring(with: match.range(at: 1))
    let openBrace = match.range.location + match.range.length - 1
    guard let end = matchingBraceEnd(in: ns, openBraceLocation: openBrace) else {
      return text
    }
    structNames.insert(name)
    let before = ns.substring(to: match.range.location)
    let after = ns.substring(from: end)
    text = before + "struct \(name)" + after
  }
}

func headerFiles(in directory: URL) throws -> [URL] {
  let contents = try FileManager.default.contentsOfDirectory(
    at: directory,
    includingPropertiesForKeys: nil,
    options: [.skipsHiddenFiles]
  )
  return contents.filter { $0.pathExtension == "h" }.sorted { $0.lastPathComponent < $1.lastPathComponent }
}

func parseModule(
  dumpDirectory: URL,
  importedKnownTypes: Set<String>
) throws -> ParsedModule {
  var parsed = ParsedModule()
  var externalSupersSeen: Set<String> = []
  var externalCategoryBasesSeen: Set<String> = []

  for file in try headerFiles(in: dumpDirectory) {
    let content = try String(contentsOf: file, encoding: .utf8)
    let lines = content.components(separatedBy: .newlines)

    var currentKind: String?
    var currentName: String?
    var block: [String] = []
    var seenLines: Set<String> = []
    var seenProperties: Set<String> = []
    var seenMethods: Set<String> = []
    var skippingIvars = false
    var ivarDepth = 0

    func finishCurrent() {
      guard let kind = currentKind, let name = currentName else { return }
      let text = block.joined(separator: "\n").trimmingCharacters(in: .whitespacesAndNewlines) + "\n"
      if kind == "class" {
        parsed.classes[name] = parsed.classes[name] ?? text
      } else if kind == "category" {
        parsed.categories.append((base: name, text: text))
      } else if kind == "protocol", !importedExternalProtocols.contains(name) {
        parsed.protocols[name] = parsed.protocols[name] ?? text
      }
      currentKind = nil
      currentName = nil
      block = []
      seenLines = []
      seenProperties = []
      seenMethods = []
    }

    for rawLine in lines {
      var line = rawLine.trimmingCharacters(in: .whitespacesAndNewlines)
      guard !line.isEmpty else {
        if currentKind != nil, block.last != "" {
          block.append("")
        }
        continue
      }
      if line.hasPrefix("//") || line.hasPrefix("#") || line.hasPrefix("@import") {
        continue
      }

      if let captured = firstCapture(line, pattern: #"^@class\s+(.+);"#) {
        for part in captured.split(separator: ",") {
          let name = part.trimmingCharacters(in: .whitespacesAndNewlines)
          if isIdentifier(name) {
            parsed.forwardClasses.insert(name)
          }
        }
        continue
      }

      if let captured = firstCapture(line, pattern: #"^@protocol\s+(.+);"#) {
        for part in captured.split(separator: ",") {
          let name = part.trimmingCharacters(in: .whitespacesAndNewlines)
          if isIdentifier(name), !importedExternalProtocols.contains(name) {
            parsed.forwardProtocols.insert(name)
          }
        }
        continue
      }

      if skippingIvars {
        ivarDepth += line.filter { $0 == "{" }.count
        ivarDepth -= line.filter { $0 == "}" }.count
        if ivarDepth <= 0 {
          skippingIvars = false
        }
        continue
      }

      line = stripInlineStructs(line, structNames: &parsed.structNames)

      if line.hasPrefix("@interface") || line.hasPrefix("@protocol") {
        finishCurrent()
        block = []
        seenLines = []
        seenProperties = []
        seenMethods = []

        if line.hasPrefix("@protocol") {
          guard let name = firstCapture(line, pattern: #"^@protocol\s+([A-Za-z_][A-Za-z0-9_]*)"#) else {
            continue
          }
          currentKind = "protocol"
          currentName = name
          block.append(line)
          continue
        }

        if let categoryBase = firstCapture(line, pattern: #"^@interface\s+([A-Za-z_][A-Za-z0-9_]*)\s*\("#) {
          currentKind = "category"
          currentName = categoryBase
          externalCategoryBasesSeen.insert(categoryBase)
          if let brace = line.firstIndex(of: "{") {
            let before = line[..<brace].trimmingCharacters(in: .whitespacesAndNewlines)
            let ivarText = String(line[brace...])
            ivarDepth = ivarText.filter { $0 == "{" }.count - ivarText.filter { $0 == "}" }.count
            skippingIvars = ivarDepth > 0
            block.append(before)
          } else {
            block.append(line)
          }
          continue
        }

        guard let className = firstCapture(line, pattern: #"^@interface\s+([A-Za-z_][A-Za-z0-9_]*)"#) else {
          continue
        }
        currentKind = "class"
        currentName = className
        if let superclass = firstCapture(line, pattern: #":\s*([A-Za-z_][A-Za-z0-9_]*)"#),
          superclass != "NSObject"
        {
          externalSupersSeen.insert(superclass)
        }
        if let brace = line.firstIndex(of: "{") {
          let before = line[..<brace].trimmingCharacters(in: .whitespacesAndNewlines)
          let ivarText = String(line[brace...])
          ivarDepth = ivarText.filter { $0 == "{" }.count - ivarText.filter { $0 == "}" }.count
          skippingIvars = ivarDepth > 0
          block.append(before)
        } else {
          block.append(line)
        }
        continue
      }

      guard currentKind != nil else { continue }

      if line == "@end" {
        block.append(line)
        finishCurrent()
        continue
      }

      if line.hasPrefix("@property"),
        let propertyName = firstCapture(line, pattern: #"\b([A-Za-z_][A-Za-z0-9_]*)\s*;$"#)
      {
        if seenProperties.contains(propertyName) {
          continue
        }
        seenProperties.insert(propertyName)
      }

      if line.hasPrefix("-") || line.hasPrefix("+") {
        let key = replaceRegex(line, pattern: #"\([^)]*\)"#, with: "()")
        if seenMethods.contains(key) {
          continue
        }
        seenMethods.insert(key)
      }

      if seenLines.contains(line) {
        continue
      }
      seenLines.insert(line)
      block.append(line)
    }

    finishCurrent()
  }

  let imported = importedExternalClasses.union(importedKnownTypes).union(["_TtCs12_SwiftObject"])
  parsed.externalSupers = externalSupersSeen.filter { !parsed.classes.keys.contains($0) && !imported.contains($0) }
  parsed.externalCategoryBases = externalCategoryBasesSeen.filter {
    !parsed.classes.keys.contains($0) && !imported.contains($0)
  }
  parsed.forwardClasses.formUnion(parsed.classes.keys)
  parsed.forwardProtocols.formUnion(parsed.protocols.keys)

  var superclassByClass: [String: String] = [:]
  for (name, text) in parsed.classes {
    guard let firstLine = text.components(separatedBy: .newlines).first,
      let superclass = firstCapture(firstLine, pattern: #":\s*([A-Za-z_][A-Za-z0-9_]*)"#),
      parsed.classes.keys.contains(superclass)
    else {
      continue
    }
    superclassByClass[name] = superclass
  }

  var ordered: [String] = []
  var temporary: Set<String> = []
  var permanent: Set<String> = []

  func visit(_ name: String) {
    if permanent.contains(name) { return }
    if temporary.contains(name) {
      permanent.insert(name)
      ordered.append(name)
      return
    }
    temporary.insert(name)
    if let superclass = superclassByClass[name] {
      visit(superclass)
    }
    temporary.remove(name)
    permanent.insert(name)
    ordered.append(name)
  }

  for name in parsed.classes.keys.sorted() {
    visit(name)
  }
  var seenOrdered: Set<String> = []
  parsed.orderedClasses = ordered.filter { seenOrdered.insert($0).inserted }
  return parsed
}

func writeModule(
  _ parsed: ParsedModule,
  config: ModuleConfig,
  sourcesRoot: URL
) throws {
  let moduleDirectory = sourcesRoot.appendingPathComponent(config.name, isDirectory: true)
  let includeDirectory = moduleDirectory
    .appendingPathComponent("include", isDirectory: true)
  try FileManager.default.createDirectory(at: includeDirectory, withIntermediateDirectories: true)

  var lines: [String] = [
    "// Normalized full dump import surface for \(config.name).",
    "// Source: local ipsw class-dump output; normalized for Swift/Clang import.",
    "#ifndef \(config.name)_h",
    "#define \(config.name)_h",
    "",
    "#import <Foundation/Foundation.h>",
  ]
  lines.append(contentsOf: config.imports)
  lines.append("")

  if config.definesSwiftObject {
    lines.append("@interface _TtCs12_SwiftObject : NSObject")
    lines.append("@end")
    lines.append("")
  }

  for name in parsed.externalSupers.union(parsed.externalCategoryBases).sorted()
  where name != "NSObject" && name != "_TtCs12_SwiftObject" {
    lines.append("@interface \(name) : NSObject")
    lines.append("@end")
  }
  lines.append("")

  for name in parsed.structNames.sorted() {
    lines.append("struct \(name);")
  }
  lines.append("")

  let forwardClasses = parsed.forwardClasses
    .filter { $0 != "NSObject" && $0 != "_TtCs12_SwiftObject" }
    .sorted()
  for chunkStart in stride(from: 0, to: forwardClasses.count, by: 12) {
    let chunkEnd = min(chunkStart + 12, forwardClasses.count)
    lines.append("@class " + forwardClasses[chunkStart..<chunkEnd].joined(separator: ", ") + ";")
  }

  let forwardProtocols = parsed.forwardProtocols.filter(isIdentifier).sorted()
  for chunkStart in stride(from: 0, to: forwardProtocols.count, by: 12) {
    let chunkEnd = min(chunkStart + 12, forwardProtocols.count)
    lines.append("@protocol " + forwardProtocols[chunkStart..<chunkEnd].joined(separator: ", ") + ";")
  }
  lines.append("")

  for name in parsed.protocols.keys.sorted() {
    if let text = parsed.protocols[name] {
      lines.append(text)
    }
  }
  for name in parsed.orderedClasses {
    if let text = parsed.classes[name] {
      lines.append(text)
    }
  }
  for category in parsed.categories.sorted(by: { $0.text < $1.text }) {
    lines.append(category.text)
  }
  lines.append("#endif /* \(config.name)_h */")

  let headerURL = includeDirectory.appendingPathComponent("\(config.name).h")
  try (lines.joined(separator: "\n\n") + "\n").write(to: headerURL, atomically: true, encoding: .utf8)

  let moduleMap = """
    module \(config.name) [system] {
      umbrella header "\(config.name).h"
      export *
    }

    """
  try moduleMap.write(
    to: includeDirectory.appendingPathComponent("module.modulemap"),
    atomically: true,
    encoding: .utf8
  )

  let shim = """
    /* Keeps this header-only Clang target materialized for product/test linking. */

    """
  try shim.write(
    to: moduleDirectory.appendingPathComponent("shim.c"),
    atomically: true,
    encoding: .utf8
  )
}

func dumpDirectory(for module: String, dumpRoot: URL) -> URL {
  dumpRoot
    .appendingPathComponent(module, isDirectory: true)
    .appendingPathComponent(module, isDirectory: true)
}

let (dumpRoot, sourcesRoot) = parseArguments()
let modules = [
  ModuleConfig(
    name: "ReminderKit",
    imports: ["@import Accounts;", "@import CloudKit;"],
    definesSwiftObject: true,
    importsModuleNames: []
  ),
  ModuleConfig(
    name: "ReminderKitInternal",
    imports: ["@import ReminderKit;", "@import Intents;", "@import CoreML;"],
    definesSwiftObject: false,
    importsModuleNames: ["ReminderKit"]
  ),
]

do {
  var parsedByModule: [String: ParsedModule] = [:]
  for config in modules {
    let importedKnownTypes = config.importsModuleNames.reduce(into: Set<String>()) { result, moduleName in
      if let imported = parsedByModule[moduleName] {
        result.formUnion(imported.classes.keys)
        result.formUnion(imported.protocols.keys)
      }
    }
    let input = dumpDirectory(for: config.name, dumpRoot: dumpRoot)
    guard FileManager.default.fileExists(atPath: input.path) else {
      throw NSError(
        domain: "NormalizeFullDump",
        code: 2,
        userInfo: [NSLocalizedDescriptionKey: "Missing dump directory: \(input.path)"]
      )
    }
    let parsed = try parseModule(dumpDirectory: input, importedKnownTypes: importedKnownTypes)
    try writeModule(parsed, config: config, sourcesRoot: sourcesRoot)
    parsedByModule[config.name] = parsed
    print(
      "\(config.name): \(parsed.classes.count) classes, \(parsed.protocols.count) protocols, \(parsed.categories.count) categories, \(parsed.structNames.count) opaque structs"
    )
  }
} catch {
  stderr("error: \(error.localizedDescription)")
  exit(1)
}
