#!/usr/bin/xcrun swift
import Foundation

let engine = URL(fileURLWithPath: CommandLine.arguments[0]).standardizedFileURL
  .deletingLastPathComponent().appendingPathComponent("framework-normalize-full-dump")
let process = Process()
process.executableURL = URL(fileURLWithPath: "/usr/bin/xcrun")
process.arguments = ["swift", engine.path, "--profile", "reminders"] + Array(CommandLine.arguments.dropFirst())
do {
  try process.run()
  process.waitUntilExit()
  exit(process.terminationStatus)
} catch {
  FileHandle.standardError.write(Data("error: Could not start the framework normalizer.\n".utf8))
  exit(1)
}
