#!/bin/sh
set -eu

task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
task_version=$(/usr/bin/xcrun swift --version)
task_numbers=$(printf '%s\n' "$task_version" | /usr/bin/sed -n 's/.*Swift version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p')
set -- $task_numbers
if [ "$#" -ne 2 ] || [ "$1" -lt 6 ] || { [ "$1" -eq 6 ] && [ "$2" -lt 3 ]; }; then
  printf '%s\n' 'apple-cli requires Swift 6.3 or newer. Select a compatible Xcode toolchain.' >&2
  exit 1
fi
task_sdk=$(/usr/bin/xcrun --sdk macosx --show-sdk-path)
task_output=${APPLE_CLI_NOTES_PRIVATE_FRAMEWORK_STUBS:-"$task_root/.build/notes-private-framework-link-stubs/current"}
cd "$task_root"
/usr/bin/xcrun swift Scripts/notes-private-framework-generate-link-stubs \
  --sdk-root "$task_sdk" --output-root "$task_output"
